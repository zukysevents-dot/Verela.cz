{%- if request.path == '/pages/kontakt' or request.path == '/pages/kontakt/' -%}
  <section class="verela-contact-page-section">
    <div class="page-width">
      {% render 'verela-contact-page', id_suffix: section.id %}
    </div>
  </section>
{%- elsif request.path == '/pages/contact' or request.path == '/pages/contact/' -%}
  <script>
    window.location.replace('/pages/kontakt');
  </script>
  <section class="verela-led-404">
    <div class="page-width">
      <p class="verela-led-kicker">Přesměrování</p>
      <h1>Kontakt najdete na nové adrese</h1>
      <p>Pokud vás prohlížeč nepřesměruje automaticky, pokračujte na kontaktní stránku Verela.cz.</p>
      <div class="verela-led-hero__actions">
        <a class="button" href="/pages/kontakt">Přejít na kontakt</a>
      </div>
    </div>
  </section>
{%- elsif request.path contains 'proc-led-terapie' -%}
  <section class="verela-led-guide">
    <div class="verela-led-guide__hero">
      {%- if section.settings.guide_image != blank -%}
        {{
          section.settings.guide_image
          | image_url: width: 2200
          | image_tag:
            class: 'verela-led-guide__image',
            loading: 'eager',
            widths: '750, 1100, 1500, 2000, 2200',
            sizes: '100vw'
        }}
      {%- endif -%}
      <div class="page-width verela-led-guide__hero-inner">
        <div class="verela-led-guide__intro">
          <p class="verela-led-kicker">Průvodce Verela</p>
          <h1>Proč LED terapie dává smysl pro domácí beauty rutinu</h1>
          <p>LED světlo se v kosmetice a wellness používá pro pravidelnou, neinvazivní péči. U pleti se nejčastěji řeší vzhled jemných linek, textura, začervenání a aknózní pleť. U těla se fotobiomodulace zkoumá hlavně jako doplněk péče o namáhané partie, například kolena nebo záda.</p>
          <div class="verela-led-guide__actions">
            <a class="button" href="/collections/led-terapie">Vybrat LED produkty</a>
            <a class="button button--secondary" href="/collections/bestsellery">Zobrazit bestsellery</a>
          </div>
        </div>
      </div>
    </div>

    <div class="page-width verela-led-guide__wrap">
      <div class="verela-led-guide__statement">
        <p>Verela komunikuje LED produkty jako beauty a wellness pomůcky. Nejde o zdravotnickou léčbu. Výsledky se liší podle typu produktu, výkonu, pravidelnosti, pleti, partie těla a správného použití.</p>
      </div>

      <div class="verela-led-guide__grid">
        <article><span>01</span><h2>Pleť a jemné linky</h2><p>Červené LED světlo se v kosmetice používá hlavně u vzhledu pleti, jemných linek a textury. U domácích zařízení je důležitá pravidelnost a realistická očekávání.</p></article>
        <article><span>02</span><h2>Aknózní pleť</h2><p>Modré a červené světlo se používá i u aknózní pleti. Může být doplňkem kosmetické rutiny, ale neslibujeme léčbu ani úplné vyčištění pleti.</p></article>
        <article><span>03</span><h2>Krk a dekolt</h2><p>Krk a dekolt navazují na obličej a často se v péči vynechávají. LED pomůcky pro tuto oblast dávají smysl jako rozšíření pravidelné rutiny.</p></article>
        <article><span>04</span><h2>Kolena a klouby</h2><p>Fotobiomodulace se zkoumá také u kolenních potíží. Bereme ji jako wellness doplněk, ne jako náhradu lékaře nebo fyzioterapie.</p></article>
        <article><span>05</span><h2>Záda a namáhané partie</h2><p>U zad, ramen a dalších partií dává smysl mluvit o domácí péči a relaxu. Při bolesti, úrazu nebo dlouhodobých potížích patří zákazník k odborníkovi.</p></article>
        <article><span>06</span><h2>Pravidelnost místo zázraků</h2><p>LED péče není jednorázový trik. Nejlépe funguje jako klidný rituál podle návodu, s ochranou očí a postupným zařazením do rutiny.</p></article>
      </div>

      <div class="verela-led-guide__choice">
        <div>
          <p class="verela-led-kicker">Jak vybrat</p>
          <h2>Který LED produkt zvolit?</h2>
        </div>
        <ul role="list">
          <li><strong>LED maska:</strong> nejlepší start pro pleť a večerní skincare rutinu.</li>
          <li><strong>Oční nebo krční péče:</strong> pro cílenější oblasti, které běžná maska nepokrývá tak pohodlně.</li>
          <li><strong>LED bandáž:</strong> pro koleno, loket nebo lokální wellness péči o namáhanou partii.</li>
          <li><strong>LED panel:</strong> pro širší použití na tělo, záda nebo větší oblast.</li>
        </ul>
      </div>
    </div>
  </section>
{%- else -%}
  <section class="verela-led-404">
    <div class="page-width">
      <p class="verela-led-kicker">Stránka nenalezena</p>
      <h1>Tahle adresa neexistuje</h1>
      <p>Pokračujte na LED produkty, bestsellery nebo hlavní stránku Verela.</p>
      <div class="verela-led-hero__actions">
        <a class="button" href="/collections/led-terapie">Nakupovat LED produkty</a>
        <a class="button button--secondary" href="{{ routes.root_url }}">Zpět na úvod</a>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Verela 404 router",
  "settings": [
    {
      "type": "image_picker",
      "id": "guide_image",
      "label": "Obrázek pro stránku Proč LED"
    }
  ]
}
{% endschema %}
