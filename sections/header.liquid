<div class="verela-header-wrapper">
  <input class="verela-menu-state" type="checkbox" id="VerelaMobileMenu">

  {% render 'verela-contact-links', variant: 'header', label: 'Jsme tu pro vás' %}

  <header class="verela-header">
    <label class="verela-mobile-toggle" for="VerelaMobileMenu" aria-label="Otevřít menu">
      <span class="verela-mobile-toggle__line"></span>
      <span class="verela-mobile-toggle__line"></span>
      <span class="verela-mobile-toggle__line"></span>
    </label>

    <a href="{{ routes.root_url }}" class="verela-logo" aria-label="{{ shop.name }}">
      {% if settings.logo != blank %}
        {{ settings.logo | image_url: width: 360 | image_tag: alt: shop.name, loading: 'eager' }}
      {% else %}
        <img
          class="verela-logo-fallback"
          src="{{ 'verela-logo.svg' | asset_url }}"
          alt="{{ shop.name | escape }}"
          width="156"
          height="64"
          loading="eager"
        >
      {% endif %}
    </a>

    <nav class="verela-menu" aria-label="Hlavní menu">
      <a href="{{ routes.root_url }}">
        <span class="verela-menu__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4 11 12 4l8 7"></path><path d="M6.5 10.5V20h11v-9.5"></path><path d="M10 20v-5h4v5"></path></svg>
        </span>
        <span class="verela-menu__text">Domů</span>
      </a>
      <a href="/pages/proc-led-terapie">
        <span class="verela-menu__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 3v18"></path><path d="M7 8h10"></path><path d="M6 14h12"></path></svg>
        </span>
        <span class="verela-menu__text">Proč LED?</span>
      </a>

      <div class="verela-category">
        <button class="verela-category-toggle" type="button" aria-expanded="false">
          <span class="verela-menu__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 5h7v7H4z"></path><path d="M13 5h7v7h-7z"></path><path d="M4 14h7v5H4z"></path><path d="M13 14h7v5h-7z"></path></svg>
          </span>
          <span class="verela-menu__text">Kategorie</span>
        </button>
        <ul class="verela-category-menu">
          <li><a href="/collections/led-terapie">LED terapie</a></li>
          <li><a href="/collections/bestsellery">Bestsellery</a></li>
          <li><a href="/collections/pece-o-plet">Péče o pleť</a></li>
          <li><a href="/collections/domaci-wellness">Masáž a regenerace</a></li>
          <li><a href="/collections/telova-pece">Tělová péče</a></li>
          <li><a href="/collections/aromaterapie">Aromaterapie</a></li>
        </ul>
      </div>

      <a href="/collections/led-terapie">
        <span class="verela-menu__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M7 4h10"></path><path d="M9 4v4l-3 8a4 4 0 0 0 4 5h4a4 4 0 0 0 4-5l-3-8V4"></path><path d="M8 15h8"></path></svg>
        </span>
        <span class="verela-menu__text">LED terapie</span>
      </a>
      <a href="/collections/bestsellery">
        <span class="verela-menu__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 4 14.4 9l5.4.8-3.9 3.8.9 5.4-4.8-2.5L7.2 19l.9-5.4-3.9-3.8L9.6 9z"></path></svg>
        </span>
        <span class="verela-menu__text">Bestsellery</span>
      </a>
      <a href="/pages/kontakt">
        <span class="verela-menu__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4 5h16v14H4z"></path><path d="m4 7 8 6 8-6"></path></svg>
        </span>
        <span class="verela-menu__text">Kontakt</span>
      </a>
    </nav>

    <div class="verela-icons">
      <a class="verela-icon" href="{{ routes.search_url }}" aria-label="Hledat">
        <span class="svg-wrapper">
          {{- 'icon-search.svg' | inline_asset_content -}}
        </span>
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <a class="verela-icon small-hide" href="{{ routes.account_url }}" aria-label="Účet">
          <span class="svg-wrapper">
            {{- 'icon-account.svg' | inline_asset_content -}}
          </span>
        </a>
      {%- endif -%}

      <a class="verela-icon verela-cart-link" href="{{ routes.cart_url }}" aria-label="Košík">
        <span class="svg-wrapper">
          {{- 'icon-cart.svg' | inline_asset_content -}}
        </span>
        {%- if cart.item_count > 0 -%}
          <span class="verela-cart-count" aria-hidden="true">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </header>

  <nav class="verela-mobile-menu" aria-label="Mobilní menu">
    <a href="{{ routes.root_url }}">Domů</a>
    <a href="/pages/proc-led-terapie">Proč LED terapie</a>
    <a href="/collections/led-terapie">LED terapie</a>
    <a href="/collections/bestsellery">Bestsellery</a>
    <a href="/collections/pece-o-plet">Péče o pleť</a>
    <a href="/collections/domaci-wellness">Masáž a regenerace</a>
    <a href="/collections/telova-pece">Tělová péče</a>
    <a href="/collections/aromaterapie">Aromaterapie</a>
    <a href="/pages/kontakt">Kontakt</a>
    {% render 'verela-contact-links', variant: 'mobile', label: 'Kontakt' %}
  </nav>
</div>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
