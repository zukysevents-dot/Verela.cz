<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    .verela-product-story {
      margin-top: 1.8rem;
      display: grid;
      gap: 1.4rem;
    }

    .verela-product-story-breakout {
      position: relative;
      z-index: 1;
    }

    .verela-premium-card {
      padding: 1.8rem;
      border: 1px solid rgba(129, 105, 72, 0.18);
      border-radius: 8px;
      background: #fbf8f2;
      color: rgba(var(--color-foreground), 0.88);
      box-shadow: 0 12px 32px rgba(66, 55, 40, 0.05);
    }

    .verela-premium-card--soft {
      background: #fffdf9;
    }

    .verela-premium-card--education {
      background: #f8f1e8;
    }

    .verela-premium-card h2,
    .verela-premium-card h3 {
      margin: 0 0 1rem;
      color: rgb(var(--color-foreground));
      letter-spacing: 0;
    }

    .verela-premium-card h2 {
      font-size: clamp(2rem, 2.4vw, 2.8rem);
      line-height: 1.18;
    }

    .verela-premium-card h3 {
      font-size: clamp(1.7rem, 2vw, 2.2rem);
      line-height: 1.25;
    }

    .verela-premium-card p {
      margin: 0;
      line-height: 1.65;
    }

    .verela-benefit-list,
    .verela-routine-list {
      margin: 1.4rem 0 0;
      padding: 0;
    }

    .verela-benefit-list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.9rem;
      list-style: none;
    }

    .verela-benefit-list li {
      display: grid;
      grid-template-columns: 2rem 1fr;
      align-items: start;
      gap: 0.8rem;
      min-width: 0;
      line-height: 1.45;
    }

    .verela-check {
      width: 1.8rem;
      height: 1.8rem;
      margin-top: 0.1rem;
      border-radius: 50%;
      border: 1px solid rgba(129, 105, 72, 0.35);
      background: #fffaf1;
      position: relative;
    }

    .verela-check::after {
      content: "";
      position: absolute;
      left: 0.58rem;
      top: 0.38rem;
      width: 0.45rem;
      height: 0.78rem;
      border: solid rgba(82, 68, 48, 0.86);
      border-width: 0 0.14rem 0.14rem 0;
      transform: rotate(45deg);
    }

    .verela-routine-list {
      counter-reset: verela-routine;
      display: grid;
      gap: 1rem;
      list-style: none;
    }

    .verela-routine-list li {
      counter-increment: verela-routine;
      display: grid;
      grid-template-columns: 2.8rem 1fr;
      gap: 1rem;
      align-items: start;
      min-width: 0;
      line-height: 1.5;
    }

    .verela-routine-list li::before {
      content: counter(verela-routine);
      display: inline-flex;
      width: 2.8rem;
      height: 2.8rem;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: #efe2d0;
      color: rgba(var(--color-foreground), 0.86);
      font-size: 1.3rem;
      font-weight: 600;
    }

    .verela-note {
      margin-top: 1.4rem;
      padding-top: 1.2rem;
      border-top: 1px solid rgba(129, 105, 72, 0.16);
      font-size: 1.3rem;
      color: rgba(var(--color-foreground), 0.68);
    }

    .verela-tech-list {
      margin: 1.2rem 0 0;
      padding: 0;
      display: grid;
      gap: 0.7rem;
      list-style: none;
    }

    .verela-tech-list li {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      min-height: 8.8rem;
      padding: 0.9rem;
      border: 1px solid rgba(129, 105, 72, 0.14);
      border-radius: 8px;
      background: rgba(255, 250, 243, 0.72);
      line-height: 1.35;
    }

    .verela-tech-list li:first-child {
      border-top: 1px solid rgba(129, 105, 72, 0.14);
      padding-top: 0.9rem;
    }

    .verela-tech-label {
      color: rgba(var(--color-foreground), 0.62);
      font-size: 1.18rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .verela-tech-list li span:last-child {
      font-size: 1.38rem;
    }

    .verela-product-story > .verela-premium-card:first-child {
      padding: 1.55rem;
    }

    .verela-product-story > .verela-premium-card:first-child h2 {
      margin-bottom: 0.75rem;
      font-size: clamp(1.9rem, 1.8vw, 2.35rem);
      line-height: 1.15;
    }

    .verela-product-story > .verela-premium-card:first-child > p:not(.verela-note) {
      font-size: 1.42rem;
      line-height: 1.55;
    }

    .verela-tech-card.is-enhanced {
      padding: 0;
      overflow: hidden;
    }

    .verela-tech-toggle {
      width: 100%;
      min-height: 6.4rem;
      padding: 1.35rem 1.55rem;
      border: 0;
      background: transparent;
      color: rgb(var(--color-foreground));
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      text-align: left;
      font: inherit;
    }

    .verela-tech-toggle__title {
      display: block;
      font-size: 1.7rem;
      font-weight: 700;
      line-height: 1.2;
    }

    .verela-tech-toggle__hint {
      display: block;
      margin-top: 0.25rem;
      color: rgba(var(--color-foreground), 0.58);
      font-size: 1.24rem;
      line-height: 1.35;
    }

    .verela-tech-toggle__icon {
      width: 2.8rem;
      height: 2.8rem;
      flex: 0 0 auto;
      border-radius: 50%;
      border: 1px solid rgba(129, 105, 72, 0.2);
      background: #fffaf1;
      position: relative;
    }

    .verela-tech-toggle__icon::before,
    .verela-tech-toggle__icon::after {
      content: "";
      position: absolute;
      left: 50%;
      top: 50%;
      width: 1rem;
      height: 0.12rem;
      background: rgba(var(--color-foreground), 0.72);
      transform: translate(-50%, -50%);
      transition: transform var(--duration-short) ease;
    }

    .verela-tech-toggle__icon::after {
      transform: translate(-50%, -50%) rotate(90deg);
    }

    .verela-tech-card.is-open .verela-tech-toggle__icon::after {
      transform: translate(-50%, -50%) rotate(0deg);
    }

    .verela-tech-card__body {
      display: none;
      padding: 0 1.55rem 1.55rem;
    }

    .verela-tech-card.is-open .verela-tech-card__body {
      display: block;
    }

    .verela-tech-card.is-enhanced .verela-note {
      margin-bottom: 0;
    }

    .verela-led-link {
      margin-top: 1.4rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 4.4rem;
      padding: 0 2rem;
      border: 1px solid rgba(var(--color-button), 0.28);
      border-radius: 8px;
      background: rgb(var(--color-button));
      color: rgb(var(--color-button-text));
      text-decoration: none;
      transition: opacity var(--duration-short) ease;
    }

    .verela-led-link:hover {
      opacity: 0.86;
      color: rgb(var(--color-button-text));
    }

    .verela-product-faq {
      padding: 0;
      overflow: hidden;
    }

    .verela-product-faq__heading {
      padding: 1.8rem 1.8rem 0;
    }

    .verela-faq-item {
      border-top: 1px solid rgba(129, 105, 72, 0.16);
    }

    .verela-faq-item:first-of-type {
      border-top: 0;
    }

    .verela-faq-item summary {
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.35rem 1.8rem;
      color: rgb(var(--color-foreground));
      font-weight: 600;
      list-style: none;
    }

    .verela-faq-item summary::-webkit-details-marker {
      display: none;
    }

    .verela-faq-item summary::after {
      content: "";
      width: 0.8rem;
      height: 0.8rem;
      flex: 0 0 auto;
      border: solid rgba(var(--color-foreground), 0.55);
      border-width: 0 0.12rem 0.12rem 0;
      transform: rotate(45deg);
      transition: transform var(--duration-short) ease;
    }

    .verela-faq-item[open] summary::after {
      transform: rotate(225deg);
    }

    .verela-faq-item__answer {
      padding: 0 1.8rem 1.5rem;
      color: rgba(var(--color-foreground), 0.72);
      line-height: 1.65;
    }

    .verela-faq-item__answer a {
      color: rgb(var(--color-foreground));
      text-underline-offset: 0.25rem;
    }

    @media screen and (min-width: 750px) {
      .verela-product-story-breakout {
        width: min(calc(100vw - 6rem), var(--page-width, 120rem));
        max-width: min(calc(100vw - 6rem), var(--page-width, 120rem));
        margin-top: 2.4rem;
        margin-left: calc((min(calc(100vw - 6rem), var(--page-width, 120rem)) - 100%) / -2);
      }

      .verela-product-story {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        align-items: start;
      }

      .verela-product-story > .verela-premium-card {
        height: 100%;
      }

      .verela-product-story > .verela-tech-card,
      .verela-product-story > .verela-product-faq {
        grid-column: 1 / -1;
        height: auto;
      }

      .verela-benefit-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .verela-tech-list {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media screen and (min-width: 1100px) {
      .verela-product-story {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .verela-product-story > .verela-tech-card,
      .verela-product-story > .verela-product-faq {
        grid-column: 1 / -1;
      }

      .verela-product-story > .verela-premium-card--education {
        grid-column: auto;
      }
    }

    @media screen and (max-width: 749px) {
      .verela-product-story {
        margin-top: 1.4rem;
        gap: 1.2rem;
      }

      .verela-premium-card {
        padding: 1.5rem;
      }

      .verela-product-story > .verela-premium-card:first-child {
        padding: 1.5rem;
      }

      .verela-product-story > .verela-premium-card:first-child.is-enhanced {
        padding: 0;
      }

      .verela-premium-card h2 {
        font-size: 2rem;
      }

      .verela-premium-card h3 {
        font-size: 1.7rem;
      }

      .verela-routine-list li {
        grid-template-columns: 2.5rem 1fr;
      }

      .verela-routine-list li::before {
        width: 2.5rem;
        height: 2.5rem;
      }

      .verela-tech-list li {
        min-height: 0;
      }

      .verela-led-link {
        width: 100%;
      }
    }
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  <div class="page-width">
    <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
      <div class="grid__item product__media-wrapper">
        {% render 'product-media-gallery', variant_images: variant_images %}
      </div>
      <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <section
          id="ProductInfo-{{ section.id }}"
          class="product__info-container{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}"
        >
          {%- assign product_form_id = 'product-form-' | append: section.id -%}
          {%- liquid
            assign led_education_url = section.settings.led_education_url
            if led_education_url == blank
              assign led_education_page = pages['proc-led-terapie']
              if led_education_page != blank
                assign led_education_url = led_education_page.url
              else
                assign led_education_url = '/pages/proc-led-terapie'
              endif
            endif

            assign verela_product_tags = product.tags | join: ' '
            assign verela_product_collections = product.collections | map: 'handle' | join: ' '
            assign verela_product_signal = product.handle | append: ' ' | append: product.title | append: ' ' | append: product.type | append: ' ' | append: verela_product_tags | append: ' ' | append: verela_product_collections | downcase
            assign verela_product_focus = 'general'
            assign verela_is_led_product = false
            if verela_product_signal contains 'led' or verela_product_signal contains 'light therapy' or verela_product_signal contains 'red light' or verela_product_signal contains 'infrared'
              assign verela_is_led_product = true
            endif

            if verela_is_led_product
              if verela_product_signal contains 'led-bandaz' or verela_product_signal contains 'kolen' or verela_product_signal contains 'knee'
                assign verela_product_focus = 'knee'
              elsif verela_product_signal contains 'krk' or verela_product_signal contains 'dekolt' or verela_product_signal contains 'neck' or verela_product_signal contains 'decollet'
                assign verela_product_focus = 'neck'
              elsif verela_product_signal contains 'ocni' or verela_product_signal contains 'oční' or verela_product_signal contains 'oko' or verela_product_signal contains 'eye'
                assign verela_product_focus = 'eye'
              elsif verela_product_signal contains 'zad' or verela_product_signal contains 'zád' or verela_product_signal contains 'back' or verela_product_signal contains 'pas'
                assign verela_product_focus = 'back'
              elsif verela_product_signal contains 'bandaz' or verela_product_signal contains 'bandáž' or verela_product_signal contains 'body' or verela_product_signal contains 'elbow'
                assign verela_product_focus = 'body'
              else
                assign verela_product_focus = 'face'
              endif
            elsif verela_product_signal contains 'massage' or verela_product_signal contains 'massager' or verela_product_signal contains 'masaz' or verela_product_signal contains 'masáž' or verela_product_signal contains 'cupping' or verela_product_signal contains 'calmagner'
              assign verela_product_focus = 'massage'
            elsif verela_product_signal contains 'essential oil' or verela_product_signal contains 'aroma' or verela_product_signal contains 'candle' or verela_product_signal contains 'diffuser' or verela_product_signal contains 'floral water' or verela_product_signal contains 'hydrosol' or verela_product_signal contains 'sage' or verela_product_signal contains 'spray'
              assign verela_product_focus = 'aroma'
            elsif verela_product_signal contains 'gua sha' or verela_product_signal contains 'jade' or verela_product_signal contains 'roller' or verela_product_signal contains 'facial massager' or verela_product_signal contains 'ice roller'
              assign verela_product_focus = 'skincare_tool'
            elsif verela_product_signal contains 'serum' or verela_product_signal contains 'cleanser' or verela_product_signal contains 'cream' or verela_product_signal contains 'toner' or verela_product_signal contains 'moisturizer' or verela_product_signal contains 'skin care' or verela_product_signal contains 'skincare'
              assign verela_product_focus = 'skincare'
            elsif verela_product_signal contains 'soap' or verela_product_signal contains 'bath' or verela_product_signal contains 'lotion' or verela_product_signal contains 'body oil' or verela_product_signal contains 'body powder'
              assign verela_product_focus = 'bath_body'
            elsif verela_product_signal contains 'beard'
              assign verela_product_focus = 'beard'
            endif
          -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
              {%- when 'text' -%}
                <p
                  class="product__text inline-richtext{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.text -}}
                </p>
              {%- when 'title' -%}
                <div class="product__title" {{ block.shopify_attributes }}>
                  <h1>{{ product.title | escape }}</h1>
                  <a href="{{ product.url }}" class="product__title">
                    <h2 class="h1">
                      {{ product.title | escape }}
                    </h2>
                  </a>
                </div>
              {%- when 'price' -%}
                <div id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
                  {%- render 'price',
                    product: product,
                    use_variant: true,
                    show_badges: true,
                    price_class: 'price--large'
                  -%}
                </div>
                {%- if product.quantity_price_breaks_configured? -%}
                  <div class="volume-pricing-note" id="Volume-Note-{{ section.id }}">
                    <span>{{ 'products.product.volume_pricing.note' | t }}</span>
                  </div>
                {%- endif -%}
                {%- if cart.taxes_included or cart.duties_included or shop.shipping_policy.body != blank -%}
                  <div class="product__tax caption rte">
                    {%- if cart.duties_included and cart.taxes_included -%}
                      {{ 'products.product.duties_and_taxes_included' | t }}
                    {%- elsif cart.taxes_included -%}
                      {{ 'products.product.taxes_included' | t }}
                    {%- elsif cart.duties_included -%}
                      {{ 'products.product.duties_included' | t }}
                    {%- endif -%}
                    {%- if shop.shipping_policy.body != blank -%}
                      {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                    {%- endif -%}
                  </div>
                {%- endif -%}
                <div {{ block.shopify_attributes }}>
                  {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                  {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    {{ form | payment_terms }}
                  {%- endform -%}
                </div>
              {%- when 'inventory' -%}
                <p
                  class="product__inventory{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.inventory_management != 'shopify' %} visibility-hidden{% endif %}"
                  {{ block.shopify_attributes }}
                  id="Inventory-{{ section.id }}"
                  role="status"
                >
                  {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
                    {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                      {%- if product.selected_or_first_available_variant.inventory_quantity
                          <= block.settings.inventory_threshold
                      -%}
                        <span class="svg-wrapper" style="color: rgb(238, 148, 65)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {%- if block.settings.show_inventory_quantity -%}
                          {{-
                            'products.product.inventory_low_stock_show_count'
                            | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                          -}}
                        {%- else -%}
                          {{- 'products.product.inventory_low_stock' | t -}}
                        {%- endif -%}
                      {%- else -%}
                        <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {%- if block.settings.show_inventory_quantity -%}
                          {{-
                            'products.product.inventory_in_stock_show_count'
                            | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                          -}}
                        {%- else -%}
                          {{- 'products.product.inventory_in_stock' | t -}}
                        {%- endif -%}
                      {%- endif -%}
                    {%- else -%}
