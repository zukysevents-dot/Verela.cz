{%- liquid
  assign contact_phone = settings.verela_contact_phone | default: '774 318 382'
  assign contact_phone_href = contact_phone | remove: ' ' | remove: '-' | remove: '.'
  unless contact_phone_href contains '+'
    assign contact_phone_href = contact_phone_href | prepend: '+420'
  endunless

  assign contact_email = settings.verela_contact_email | default: shop.email
  assign contact_label = label | default: 'Kontakt'
  assign contact_variant = variant | default: 'default'
-%}

<div class="verela-contact-links verela-contact-links--{{ contact_variant }}">
  <span class="verela-contact-links__label">{{ contact_label }}</span>

  {%- if contact_phone != blank -%}
    <a class="verela-contact-links__item" href="tel:{{ contact_phone_href }}">
      <span class="verela-contact-links__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.3 1.2.4 2.5.6 3.8.6.7 0 1.2.5 1.2 1.2v3.5c0 .7-.5 1.2-1.2 1.2C10.3 21.9 2.1 13.7 2.1 3.6c0-.7.5-1.2 1.2-1.2h3.5c.7 0 1.2.5 1.2 1.2 0 1.3.2 2.6.6 3.8.1.4 0 .9-.3 1.2l-1.7 2.2z"></path>
        </svg>
      </span>
      <span class="verela-contact-links__text">
        <span class="verela-contact-links__eyebrow">Telefon</span>
        <span>{{ contact_phone }}</span>
      </span>
    </a>
  {%- endif -%}

  {%- if contact_email != blank -%}
    <a class="verela-contact-links__item" href="mailto:{{ contact_email }}">
      <span class="verela-contact-links__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M4 5h16c1.1 0 2 .9 2 2v10c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2zm8 8.1L4.7 7H4v.8l8 6.7 8-6.7V7h-.7L12 13.1z"></path>
        </svg>
      </span>
      <span class="verela-contact-links__text">
        <span class="verela-contact-links__eyebrow">E-mail</span>
        <span>{{ contact_email }}</span>
      </span>
    </a>
  {%- endif -%}

  {%- if settings.social_instagram_link != blank -%}
    <a class="verela-contact-links__item" href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">
      <span class="verela-contact-links__icon" aria-hidden="true">
        {{- 'icon-instagram.svg' | inline_asset_content -}}
      </span>
      <span class="verela-contact-links__text">
        <span class="verela-contact-links__eyebrow">Sledujte nás</span>
        <span>Instagram</span>
      </span>
    </a>
  {%- endif -%}

  {%- if settings.social_facebook_link != blank -%}
    <a class="verela-contact-links__item" href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener">
      <span class="verela-contact-links__icon" aria-hidden="true">
        {{- 'icon-facebook.svg' | inline_asset_content -}}
      </span>
      <span class="verela-contact-links__text">
        <span class="verela-contact-links__eyebrow">Sledujte nás</span>
        <span>Facebook</span>
      </span>
    </a>
  {%- endif -%}
</div>
