{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign fallback_og_image = 'verela-social-preview-v4.png' | asset_url | prepend: 'https:'
  assign og_image = fallback_og_image
  assign og_image_width = 1200
  assign og_image_height = 630

  if request.page_type == 'product'
    assign og_type = 'product'
    if product.featured_image
      assign og_image = product.featured_image | image_url: width: 1200 | prepend: 'https:'
      assign og_image_width = product.featured_image.width
      assign og_image_height = product.featured_image.height
    elsif page_image
      assign og_image = page_image | image_url: width: 1200 | prepend: 'https:'
      assign og_image_width = page_image.width
      assign og_image_height = page_image.height
    endif
  elsif request.page_type == 'article'
    assign og_type = 'article'
    if page_image
      assign og_image = page_image | image_url: width: 1200 | prepend: 'https:'
      assign og_image_width = page_image.width
      assign og_image_height = page_image.height
    endif
  elsif request.page_type == 'password'
    assign og_url = request.origin
  elsif request.page_type != 'index' and page_image
    assign og_image = page_image | image_url: width: 1200 | prepend: 'https:'
    assign og_image_width = page_image.width
    assign og_image_height = page_image.height
  endif

  if request.page_type == 'index'
    assign og_title = 'Verela.cz'
    assign og_description = 'Beauty a wellness pomůcky pro moderní domácí péči. LED masky, skincare doplňky a self-care produkty pro každodenní rutinu.'
  endif
-%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:locale" content="cs_CZ">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:image" content="{{ og_image }}">
<meta property="og:image:url" content="{{ og_image }}">
<meta property="og:image:secure_url" content="{{ og_image }}">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="{{ og_image_width }}">
<meta property="og:image:height" content="{{ og_image_height }}">
<meta property="og:image:alt" content="Verela.cz - beauty a wellness pomůcky pro domácí péči">
<link rel="image_src" href="{{ og_image }}">
<meta itemprop="image" content="{{ og_image }}">

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
<meta name="twitter:image" content="{{ og_image }}">
<meta name="twitter:image:alt" content="Verela.cz - beauty a wellness pomůcky pro domácí péči">
