<section class="verela-trust-bar color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="verela-trust-bar__head">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="verela-trust-bar__list" role="list">
      {%- for block in section.blocks -%}
        <li class="verela-trust-bar__item" {{ block.shopify_attributes }}>
          <span class="verela-trust-bar__mark" aria-hidden="true"></span>
          <span class="verela-trust-bar__content">
            <strong>{{ block.settings.title }}</strong>
            {%- if block.settings.text != blank -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Verela trust bar",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Barevné schéma",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nadpis",
      "default": "Nákup, který působí jistě"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "U beauty technologií zákazník potřebuje hlavně cenu, doručení, kontakt a jednoduché vrácení. Proto jsou tyto informace vidět hned."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Položka",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nadpis",
          "default": "Bezpečná platba"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Kartou nebo podporovanou platební metodou"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Verela trust bar",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Bezpečná platba",
            "text": "Kartou nebo podporovanou platební metodou"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Doručení 5-12 dnů",
            "text": "Jasně uvedeno u nákupu"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Vrácení do 14 dnů",
            "text": "U nepoužitého zboží podle podmínek"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Český kontakt",
            "text": "Podpora pro dotazy k objednávce"
          }
        }
      ]
    }
  ]
}
{% endschema %}
