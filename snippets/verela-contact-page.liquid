{%- liquid
  assign contact_phone = settings.verela_contact_phone | default: '+420 774 318 382'
  assign contact_phone_href = contact_phone | remove: ' ' | remove: '-' | remove: '.'
  unless contact_phone_href contains '+'
    assign contact_phone_href = contact_phone_href | prepend: '+420'
  endunless

  assign contact_email = settings.verela_contact_email | default: 'info@verela.cz'
  assign form_id_suffix = id_suffix | default: section.id | default: 'page'
  assign contact_form_id = 'VerelaContactForm-' | append: form_id_suffix
  assign instagram_link = settings.social_instagram_link | default: 'https://www.instagram.com/verela.cz/'
  assign facebook_link = settings.social_facebook_link | default: 'https://www.facebook.com/verela.cz/'
-%}

<div class="verela-contact-page">
  <section class="verela-contact-hero">
    <div class="verela-contact-hero__content">
      <p class="verela-contact-hero__kicker">Verela.cz</p>
      <h1>Kontakt</h1>
      <p>
        Máte dotaz k objednávce, doručení, vrácení zboží nebo výběru produktu?
        Jsme vám k dispozici e-mailem, telefonicky nebo přes kontaktní formulář.
      </p>
      <div class="verela-contact-hero__badges" aria-label="Výhody kontaktu Verela">
        <span>Bezpečná platba</span>
        <span>Doručení 5-12 dnů</span>
        <span>Vrácení do 14 dnů</span>
      </div>
      <div class="verela-contact-mini">
        <div class="verela-contact-mini__item">
          <span class="verela-contact-mini__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path d="M4 5h16c1.1 0 2 .9 2 2v8c0 1.1-.9 2-2 2H8.8l-4.1 3.1c-.7.5-1.7 0-1.7-.9V7c0-1.1.9-2 2-2zm2.7 3.6 5.3 4.2 5.3-4.2H6.7zm-.7 1.7V15h12v-4.7l-5.4 4.3c-.4.3-.9.3-1.2 0L6 10.3z"></path>
            </svg>
          </span>
          <strong>Rychlá odpověď</strong>
          <span>Odpovídáme co nejdříve v pracovních dnech.</span>
        </div>
        <div class="verela-contact-mini__item">
          <span class="verela-contact-mini__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path d="M12 2.2 4.5 5.6v5.1c0 4.8 3.2 9.2 7.5 10.6 4.3-1.4 7.5-5.8 7.5-10.6V5.6L12 2.2zm3.7 7.3-4.5 4.5-2.3-2.3-1.3 1.3 3.6 3.6L17 10.8l-1.3-1.3z"></path>
            </svg>
          </span>
          <strong>Jasná podpora</strong>
          <span>Pomůžeme s objednávkou, doručením i výběrem.</span>
        </div>
      </div>
    </div>
    <div class="verela-contact-hero__panel">
      <h2>Kontaktní údaje</h2>
      <dl class="verela-contact-details">
        <div class="verela-contact-detail">
          <span class="verela-contact-detail__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path d="M4 20V9l8-6 8 6v11h-5v-6H9v6H4zm2-2h1v-6h10v6h1V10l-6-4.5L6 10v8z"></path>
            </svg>
          </span>
          <div>
            <dt>Název</dt>
            <dd>Verela.cz</dd>
          </div>
        </div>
        <div class="verela-contact-detail">
          <span class="verela-contact-detail__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path d="M12 12c2.3 0 4.1-1.8 4.1-4.1S14.3 3.8 12 3.8 7.9 5.6 7.9 7.9 9.7 12 12 12zm0 2c-3.1 0-7 1.6-7 4.6V20h14v-1.4c0-3-3.9-4.6-7-4.6z"></path>
            </svg>
          </span>
          <div>
            <dt>CEO / hlavní kontaktní osoba</dt>
            <dd>Patrik Zukal</dd>
          </div>
        </div>
        <div class="verela-contact-detail">
          <span class="verela-contact-detail__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.3 1.2.4 2.5.6 3.8.6.7 0 1.2.5 1.2 1.2v3.5c0 .7-.5 1.2-1.2 1.2C10.3 21.9 2.1 13.7 2.1 3.6c0-.7.5-1.2 1.2-1.2h3.5c.7 0 1.2.5 1.2 1.2 0 1.3.2 2.6.6 3.8.1.4 0 .9-.3 1.2l-1.7 2.2z"></path>
            </svg>
          </span>
          <div>
            <dt>Telefon</dt>
            <dd><a href="tel:{{ contact_phone_href }}">{{ contact_phone }}</a></dd>
          </div>
        </div>
        <div class="verela-contact-detail">
          <span class="verela-contact-detail__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path d="M4 5h16c1.1 0 2 .9 2 2v10c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2zm8 8.1L4.7 7H4v.8l8 6.7 8-6.7V7h-.7L12 13.1z"></path>
            </svg>
          </span>
          <div>
            <dt>E-mail</dt>
            <dd><a href="mailto:{{ contact_email }}">{{ contact_email }}</a></dd>
          </div>
        </div>
        <div class="verela-contact-detail">
          <span class="verela-contact-detail__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path d="M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3zm0 2A2.5 2.5 0 0 0 5 7.5v9A2.5 2.5 0 0 0 7.5 19h9a2.5 2.5 0 0 0 2.5-2.5v-9A2.5 2.5 0 0 0 16.5 5h-9zM12 8a4 4 0 1 1 0 8 4 4 0 0 1 0-8zm0 2a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm4.8-2.6a.8.8 0 1 1 0 1.6.8.8 0 0 1 0-1.6z"></path>
            </svg>
          </span>
          <div>
            <dt>Sociální sítě</dt>
            <dd class="verela-contact-socials">
              <a href="{{ instagram_link }}" target="_blank" rel="noopener">
                {{- 'icon-instagram.svg' | inline_asset_content -}}
                Instagram
              </a>
              <a href="{{ facebook_link }}" target="_blank" rel="noopener">
                {{- 'icon-facebook.svg' | inline_asset_content -}}
                Facebook
              </a>
            </dd>
          </div>
        </div>
      </dl>
      <p class="verela-contact-trust">
        <span class="verela-contact-trust__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm4.3 8.1-5 5a1 1 0 0 1-1.4 0l-2.2-2.2 1.4-1.4 1.5 1.5 4.3-4.3 1.4 1.4z"></path>
          </svg>
        </span>
        Odpovídáme co nejdříve v pracovních dnech.
      </p>
    </div>
  </section>

  <section class="verela-contact-grid" aria-label="Kontaktní možnosti">
    <a class="verela-contact-card" href="tel:{{ contact_phone_href }}">
      <span class="verela-contact-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.3 1.2.4 2.5.6 3.8.6.7 0 1.2.5 1.2 1.2v3.5c0 .7-.5 1.2-1.2 1.2C10.3 21.9 2.1 13.7 2.1 3.6c0-.7.5-1.2 1.2-1.2h3.5c.7 0 1.2.5 1.2 1.2 0 1.3.2 2.6.6 3.8.1.4 0 .9-.3 1.2l-1.7 2.2z"></path>
        </svg>
      </span>
      <strong>Telefon</strong>
      <span>{{ contact_phone }}</span>
    </a>

    <a class="verela-contact-card" href="mailto:{{ contact_email }}">
      <span class="verela-contact-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M4 5h16c1.1 0 2 .9 2 2v10c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2zm8 8.1L4.7 7H4v.8l8 6.7 8-6.7V7h-.7L12 13.1z"></path>
        </svg>
      </span>
      <strong>E-mail</strong>
      <span>{{ contact_email }}</span>
    </a>

    {%- if instagram_link != blank -%}
      <a class="verela-contact-card" href="{{ instagram_link }}" target="_blank" rel="noopener">
        <span class="verela-contact-card__icon" aria-hidden="true">
          {{- 'icon-instagram.svg' | inline_asset_content -}}
        </span>
        <strong>Instagram</strong>
        <span>Novinky, inspirace a produkty Verela.cz</span>
      </a>
    {%- endif -%}

    {%- if facebook_link != blank -%}
      <a class="verela-contact-card" href="{{ facebook_link }}" target="_blank" rel="noopener">
        <span class="verela-contact-card__icon" aria-hidden="true">
          {{- 'icon-facebook.svg' | inline_asset_content -}}
        </span>
        <strong>Facebook</strong>
        <span>Aktuality a rychlý kontakt</span>
      </a>
    {%- endif -%}
  </section>

  <section class="verela-contact-support">
    <div>
      <p class="verela-contact-hero__kicker">Podpora</p>
      <h2>S čím vám pomůžeme?</h2>
      <p>
        Naším cílem je, aby byl nákup na Verela.cz jednoduchý, přehledný a důvěryhodný.
        Pokud si nejste jistí výběrem produktu nebo potřebujete poradit s objednávkou, napište nám.
      </p>
    </div>
    <ul class="verela-contact-support__items" role="list">
      <li>Dotazy k objednávce</li>
      <li>Informace o doručení</li>
      <li>Vrácení nebo výměna zboží</li>
      <li>Pomoc s výběrem produktu</li>
      <li>Obecné dotazy k e-shopu Verela.cz</li>
    </ul>
  </section>

  <section class="verela-contact-form-card">
    <div class="verela-contact-form-card__intro">
      <p class="verela-contact-hero__kicker">Napište nám</p>
      <h2>Kontaktní formulář</h2>
      <p>Vyplňte formulář a ozveme se vám co nejdříve. Do zprávy prosím napište, s čím potřebujete poradit.</p>
    </div>

    {%- form 'contact', id: contact_form_id, class: 'verela-contact-form' -%}
      {%- if form.posted_successfully? -%}
        <h3 class="form-status form__message" tabindex="-1" autofocus>
          {{- 'icon-success.svg' | inline_asset_content -}}
          {{ 'templates.contact.form.post_success' | t }}
        </h3>
      {%- elsif form.errors -%}
        <div class="form__message">
          <h3 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
            {{- 'icon-error.svg' | inline_asset_content -}}
            {{ 'templates.contact.form.error_heading' | t }}
          </h3>
        </div>
      {%- endif -%}

      <div class="verela-contact-form__fields">
        <div class="field">
          <input class="field__input" autocomplete="name" type="text" id="VerelaContactForm-name-{{ form_id_suffix }}" name="contact[{{ 'templates.contact.form.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="{{ 'templates.contact.form.name' | t }}">
          <label class="field__label" for="VerelaContactForm-name-{{ form_id_suffix }}">{{ 'templates.contact.form.name' | t }}</label>
        </div>
        <div class="field field--with-error">
          <input autocomplete="email" type="email" id="VerelaContactForm-email-{{ form_id_suffix }}" class="field__input" name="contact[email]" spellcheck="false" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" aria-required="true" {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="VerelaContactForm-email-error-{{ form_id_suffix }}"{% endif %} placeholder="{{ 'templates.contact.form.email' | t }}">
          <label class="field__label" for="VerelaContactForm-email-{{ form_id_suffix }}">{{ 'templates.contact.form.email' | t }} <span aria-hidden="true">*</span></label>
          {%- if form.errors contains 'email' -%}
            <small class="contact__field-error" id="VerelaContactForm-email-error-{{ form_id_suffix }}">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              <span class="form__message">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span>
            </small>
          {%- endif -%}
        </div>
      </div>

      <div class="field">
        <input type="tel" id="VerelaContactForm-phone-{{ form_id_suffix }}" class="field__input" autocomplete="tel" name="contact[{{ 'templates.contact.form.phone' | t }}]" pattern="[0-9\- +]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" placeholder="{{ 'templates.contact.form.phone' | t }}">
        <label class="field__label" for="VerelaContactForm-phone-{{ form_id_suffix }}">{{ 'templates.contact.form.phone' | t }}</label>
      </div>

      <div class="field">
        <textarea rows="7" id="VerelaContactForm-body-{{ form_id_suffix }}" class="text-area field__input" name="contact[{{ 'templates.contact.form.comment' | t }}]" placeholder="{{ 'templates.contact.form.comment' | t }}">{{- form.body -}}</textarea>
        <label class="form__label field__label" for="VerelaContactForm-body-{{ form_id_suffix }}">{{ 'templates.contact.form.comment' | t }}</label>
      </div>

      <button type="submit" class="button verela-contact-form__button">
        Odeslat zprávu
      </button>
    {%- endform -%}
  </section>
</div>
